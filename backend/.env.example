DATABASE_URL=
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
JWT_REFRESH_SECRET=use-a-different-random-value-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:4200
APP_BASE_URL=http://localhost:4200

# Optional: password recovery email via Resend. Recovery stays disabled until all are configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: enables image-based figure identification through Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
