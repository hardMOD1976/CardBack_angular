generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Manufacturer {
  id            String    @id @default(cuid())
  name          String    @unique
  foundedYear   Int?
  dissolvedYear Int?
  country       String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lines         Line[]

  @@index([name])
}

model Franchise {
  id              String      @id @default(cuid())
  name            String      @unique
  owner           String?
  firstAppearance Int?
  description     String?
  logo            String?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  characters      Character[]
  lines           Line[]

  @@index([name])
}

model Line {
  id             String       @id @default(cuid())
  name           String
  startYear      Int?
  endYear        Int?
  scale          String?
  logo           String?
  description    String?
  manufacturerId String
  franchiseId    String
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  figures        Figure[]
  franchise      Franchise    @relation(fields: [franchiseId], references: [id])
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@unique([manufacturerId, name])
  @@index([name])
  @@index([manufacturerId])
  @@index([franchiseId])
}

model Character {
  id          String    @id @default(cuid())
  name        String
  species     String?
  homeworld   String?
  affiliation String?
  description String?
  image       String?
  franchiseId String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  figures     Figure[]

  @@unique([franchiseId, name])
  @@index([name])
  @@index([franchiseId])
}

model Figure {
  id           String    @id @default(cuid())
  name         String
  code         String?
  description  String?
  imageUrl String?
  characterId  String
  lineId       String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  character    Character @relation(fields: [characterId], references: [id])
  line         Line      @relation(fields: [lineId], references: [id])
  variants     Variant[]

  @@unique([lineId, characterId, name])
  @@index([name])
  @@index([code])
  @@index([characterId])
  @@index([lineId])
}

model Variant {
  id              String           @id @default(cuid())
  name            String?
  description     String?
  imageUrl String?
  figureId        String
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productReleases ProductRelease[]
  figure          Figure           @relation(fields: [figureId], references: [id])

  @@unique([figureId, name])
  @@index([figureId])
}

model ProductRelease {
  id            String        @id @default(cuid())
  name          String
  packagingType String?
  region        String?
  language      String?
  retailer      String?
  releaseDate   DateTime?
  barcode       String?
  notes         String?
  imageUrl String?
  variantId     String
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ownedFigures  OwnedFigure[]
  wishlistEntries WishlistEntry[]
  variant       Variant       @relation(fields: [variantId], references: [id])

  @@unique([variantId, name])
  @@index([variantId])
  @@index([barcode])
}

model OwnedFigure {
  id                   String         @id @default(cuid())
  userId               String
  productReleaseId     String
  condition            String
  completeness         String
  packagingState       String?
  purchaseDate         DateTime?
  purchasePrice        Decimal?
  currency             String?
  purchaseLocation     String?
  estimatedMarketValue Decimal?
  storageLocation      String?
  notes                String?
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  quantity             Int            @default(1)
  productRelease       ProductRelease @relation(fields: [productReleaseId], references: [id])
  user                 User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productReleaseId])
}

model User {
  id               String        @id @default(cuid())
  username         String        @unique
  displayName      String?
  email            String?       @unique
  country          String?
  avatar           String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  passwordHash     String
  role             Role          @default(USER)
  refreshTokenHash String?
  ownedFigures     OwnedFigure[]
  passwordResetTokens PasswordResetToken[]
  wishlistEntries WishlistEntry[]

  @@index([username])
}

model WishlistEntry {
  id               String         @id @default(cuid())
  userId           String
  productReleaseId String
  targetPrice      Decimal?
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productRelease   ProductRelease @relation(fields: [productReleaseId], references: [id], onDelete: Restrict)

  @@unique([userId, productReleaseId])
  @@index([userId, deletedAt])
  @@index([productReleaseId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  USER
  ADMIN
}
