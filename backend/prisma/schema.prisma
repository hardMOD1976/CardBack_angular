// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Manufacturer {
  id             String   @id @default(cuid())

  name           String   @unique

  foundedYear    Int?
  dissolvedYear  Int?
  country        String?

  deletedAt      DateTime?

  lines          Line[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

model Franchise {
  id              String   @id @default(cuid())

  name            String   @unique

  owner           String?
  firstAppearance Int?
  description     String?
  logo            String?

  deletedAt       DateTime?

  lines           Line[]
  characters      Character[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
}

model Line {
  id             String   @id @default(cuid())

  name           String

  startYear      Int?
  endYear        Int?

  scale          String?
  logo           String?
  description    String?

  manufacturerId String
  franchiseId    String

  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  franchise      Franchise    @relation(fields: [franchiseId], references: [id])

  figures        Figure[]

  deletedAt      DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([manufacturerId, name])

  @@index([name])
  @@index([manufacturerId])
  @@index([franchiseId])
}

model Character {
  id            String   @id @default(cuid())
  name          String

  species       String?
  homeworld     String?
  affiliation   String?
  description   String?
  image         String?

  franchiseId   String

  franchise     Franchise @relation(fields: [franchiseId], references: [id])

  figures       Figure[]

  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([franchiseId, name])

  @@index([name])
  @@index([franchiseId])
}

model Figure {
  id            String   @id @default(cuid())

  name          String
  code          String?
  description   String?
  defaultImage  String?

  characterId   String
  lineId        String

  character     Character @relation(fields: [characterId], references: [id])
  line          Line      @relation(fields: [lineId], references: [id])

  variants      Variant[]

  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([lineId, characterId, name])

  @@index([name])
  @@index([code])
  @@index([characterId])
  @@index([lineId])
}

model Variant {
  id              String   @id @default(cuid())

  name            String?
  description     String?
  defaultImage    String?

  figureId        String

  figure          Figure @relation(fields: [figureId], references: [id])

  productReleases ProductRelease[]

  deletedAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([figureId, name])

  @@index([figureId])
}

model ProductRelease {
  id             String   @id @default(cuid())

  name           String

  packagingType  String?
  region         String?
  language       String?
  retailer       String?
  releaseDate    DateTime?
  barcode        String?
  notes          String?
  defaultImage   String?

  variantId      String

  variant         Variant @relation(fields: [variantId], references: [id])

  ownedFigures    OwnedFigure[]

  deletedAt      DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([variantId, name])

  @@index([variantId])
  @@index([barcode])
}

model OwnedFigure {
  id                   String   @id @default(cuid())

  userId               String
  productReleaseId     String

  condition            String
  completeness         String

  packagingState       String?

  purchaseDate         DateTime?
  purchasePrice        Decimal?
  currency             String?

  purchaseLocation     String?

  estimatedMarketValue Decimal?

  storageLocation      String?

  notes                String?

  user                 User @relation(fields: [userId], references: [id])
  productRelease       ProductRelease @relation(fields: [productReleaseId], references: [id])

  deletedAt            DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([productReleaseId])
  @@unique([userId, productReleaseId])
}

model User {
  id                String   @id @default(cuid())

  username          String   @unique
  displayName       String?

  role              Role     @default(USER)

  email             String?  @unique

  passwordHash      String

  refreshTokenHash  String?

  lastLoginAt       DateTime?

  emailVerifiedAt   DateTime?

  country           String?

  avatar            String?

  ownedFigures      OwnedFigure[]

  deletedAt         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([username])
}